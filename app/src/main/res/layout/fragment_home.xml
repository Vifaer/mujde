<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_card_title"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="@string/status_loading"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_card_title"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_inject_once"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:text="@string/inject_once"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_scope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/auto_scope"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_console_bridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/console_bridge"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_antifrida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/antifrida_enable"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_antifrida_agg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/antifrida_aggressive"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/script_log_tag_hint"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_script_log_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/script_log_tag_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_inject_delay_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/inject_delay_label"
                android:textColor="@color/on_surface" />

            <SeekBar
                android:id="@+id/seek_inject_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10000"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/antifrida_boundary_hint"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_health_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/health_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_status"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/refresh"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_root"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_root_manager"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_lsposed"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_lsposed"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_zygisk"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_zygisk_config"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent" />
    </LinearLayout>
</ScrollView>
